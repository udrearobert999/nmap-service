# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=NetworkMapperDb
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=NetworkMapperDb;Username=admin;Password=password123;

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCAN_REQUESTS_TOPIC=scan-requested
KAFKA_SCAN_REQUESTS_TOPIC=scan-requests-topic
KAFKA_SCAN_REQUESTS_CONSUMER_GROUP=network-mapper-worker
KAFKA_SCAN_REQUESTS_CONCURRENT_MESSAGES_LIMIT=10
KAFKA_SCAN_REQUESTS_CONCURRENT_CONSUMER_LIMIT=5

# NMAP
NMAP_TIMEOUT_SECONDS=420

# Vulnintel service (Go)
VULNINTEL_DB_CONNECTION_STRING=postgres://admin:password123@postgres:5432/NetworkMapperDb?sslmode=disable
VULNINTEL_HTTP_PORT=8090
KAFKA_RISK_ASSESSMENT_CONSUMER_GROUP=vulnintel-service
KAFKA_SCAN_RISK_ASSESSMENT_REQUESTS_TOPIC=scan-risk-assessment-requests-topic

# Common
ASPNETCORE_ENVIRONMENT=Development