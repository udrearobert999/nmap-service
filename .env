# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=VantageDb
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=VantageDb;Username=admin;Password=password123;

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCAN_REQUESTS_TOPIC=scan-requested
KAFKA_SCAN_REQUESTS_TOPIC=scan-requests-topic
KAFKA_SCAN_REQUESTS_CONSUMER_GROUP=vantage-worker
KAFKA_SCAN_REQUESTS_CONCURRENT_MESSAGES_LIMIT=10
KAFKA_SCAN_REQUESTS_CONCURRENT_CONSUMER_LIMIT=5

# NMAP
NMAP_TIMEOUT_SECONDS=660

# Vulnintel service (Go)
VULNINTEL_DB_CONNECTION_STRING=postgres://admin:password123@postgres:5432/VantageDb?sslmode=disable
VULNINTEL_HTTP_PORT=8090
KAFKA_RISK_ASSESSMENT_CONSUMER_GROUP=vulnintel-service
KAFKA_SCAN_RISK_ASSESSMENT_REQUESTS_TOPIC=scan-risk-assessment-requests-topic

NVD_API_KEY=

# Portal (UI)
# Publishable key from your Clerk development instance (Organizations enabled).
# Safe to expose (it's a client key). Leave empty to see the "set your key" screen.
VITE_CLERK_PUBLISHABLE_KEY=

# Common
ASPNETCORE_ENVIRONMENT=Development

AUTH_MODE=
CLERK_AUTHORITY=
CLERK_AUDIENCE=
CLERK_WEBHOOK_SIGNING_SECRET=